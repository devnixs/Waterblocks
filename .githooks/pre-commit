#!/bin/sh
# Regenerates runtime skill stubs from .common-ai/skills/ canonical sources
# whenever a canonical file (or the sync script itself) is staged for commit,
# so the runtime stubs under .claude/skills/ and .codex/skills/ stay in sync.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks

set -e

staged="$(git diff --cached --name-only)"

if ! printf '%s\n' "$staged" | grep -qE '^\.common-ai/(skills/|scripts/sync-skills\.js)'; then
  exit 0
fi

echo "[pre-commit] Syncing skill stubs from .common-ai/skills/..."
node .common-ai/scripts/sync-skills.js

# Stage anything the sync regenerated so this commit covers both the canonical
# change and the propagated stub change. Scoped to skill paths only — unrelated
# working-tree changes under .claude/ or .codex/ are not touched.
git add \
  '.claude/skills/*/SKILL.md' \
  '.codex/skills/*/SKILL.md' \
  '.codex/skills/*/agents/openai.yaml' 2>/dev/null || true
