# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=waterblocks

# Connection String (used by the API)
# This is automatically constructed in docker-compose.yml
# For local development outside Docker, use:
# ConnectionStrings__DefaultConnection=Host=localhost;Database=waterblocks;Username=postgres;Password=postgres

# Exchange simulators of Off Exchange exchange accounts. The exchange catalog (Supported exchanges page)
# holds each simulator URL. These optional settings use the exchange type in the name:
# BASE_URL fills an empty simulator URL of that exchange at startup.
EXCHANGE_SIMULATORS__GATEIO__BASE_URL=http://host.docker.internal:8083
# ADMIN_TOKEN is sent as X-Admin-Token on the calls to that simulator. It stays out of the database.
EXCHANGE_SIMULATORS__GATEIO__ADMIN_TOKEN=

# Optional Datadog log shipping
# Set this to enable Datadog log forwarding from the API.
DATADOG_API_KEY=
