# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=waterblocks

# Connection String (used by the API)
# This is automatically constructed in docker-compose.yml
# For local development outside Docker, use:
# ConnectionStrings__DefaultConnection=Host=localhost;Database=waterblocks;Username=postgres;Password=postgres

# Optional Datadog log shipping
# Set this to enable Datadog log forwarding from the API.
DATADOG_API_KEY=
